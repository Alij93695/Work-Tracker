{
  "name": "scribe",
  "version": "2.0.0",
  "description": "Scribe — silent work tracking and local meeting capture",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build-watcher": "\"%WINDIR%\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe\" -nologo -optimize -out:ActiveWindow.exe ActiveWindow.cs",
    "sync-dashboard": "node -e \"const fs=require('fs');fs.rmSync('dashboard',{recursive:true,force:true});fs.cpSync('../frontend/dist','dashboard',{recursive:true});console.log('dashboard synced');\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.scribe.app",
    "productName": "Scribe",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "extraResources": [
      "ActiveWindow.exe",
      "src/whisper_worker.py"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google/genai": "^2.8.0",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.1",
    "csv-writer": "^1.6.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^26.15.2"
  }
}
